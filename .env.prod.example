# Copy to .env.prod and fill in. NEVER commit .env.prod.
# Generate secrets with:  python -c "import secrets; print(secrets.token_hex(32))"

# --- required ---------------------------------------------------------------
POSTGRES_PASSWORD=
JWT_SECRET=
SCHEDULER_TOKEN=
# The address customers reach the app on. LAN today (http://192.168.x.x),
# the real domain later (https://park.madcotruckplaza.com).
PUBLIC_BASE_URL=http://localhost

# --- money (test keys until Stripe business verification completes) ----------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From Stripe Dashboard -> Developers -> Webhooks after adding the endpoint
# {PUBLIC_BASE_URL}/api/payments/stripe/webhook — the charge-recovery safety
# net is OFF without it (the backend warns at startup).
STRIPE_WEBHOOK_SECRET=

# --- texting (optional until A2P campaign is approved) -----------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# --- optional -----------------------------------------------------------------
# Slack/Discord/ntfy webhook that gets pinged on every application ERROR.
ALERT_WEBHOOK_URL=
TIMEZONE=America/Detroit
PARKING_CAPACITY=150
