    "var_0d1796464303": {
      "type": "variant",
      "label": "Dashboard: Master Ledger",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "\n<div class=\"min-h-screen flex selection:bg-[#3D2B1F]/20\" data-scroll-container data-kid=\"0\">\n  \n  <style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&family=Crimson+Pro:ital,wght@0,200..900;1,200..900&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    :root {\n      --parchment: #F4F0EC;\n      --dark-coffee: #3D2B1F;\n      --mahogany: #801a1a;\n      --emerald: #1a4d3a;\n      --gold: #B8860B;\n    }\n\n    body {\n      background-color: var(--parchment);\n      color: var(--dark-coffee);\n      font-family: 'Crimson Pro', serif;\n      margin: 0;\n    }\n\n    .font-serif-heading { font-family: 'Newsreader', serif; }\n    \n    /* Leather Sidebar Texture */\n    .leather-sidebar {\n      background: linear-gradient(135deg, #3D2B1F 0%, #2D1F16 100%);\n      position: relative;\n    }\n    .leather-sidebar::after {\n      content: \"\";\n      position: absolute;\n      inset: 0;\n      background-image: url('https://www.transparenttextures.com/patterns/leather.png');\n      opacity: 0.15;\n      pointer-events: none;\n    }\n\n    /* Paper Texture for Main */\n    .paper-texture {\n      background-image: \n        url('https://www.transparenttextures.com/patterns/natural-paper.png'),\n        url('https://images.unsplash.com/photo-1601662528567-526cd06f6582?auto=format&w=1600&q=80&fit=crop');\n      background-attachment: fixed;\n      background-size: auto, cover;\n    }\n\n    /* Ink Bleed Stamp Effect */\n    .ink-stamp {\n      position: relative;\n      display: inline-block;\n      padding: 0.25rem 1rem;\n      border: 2px solid currentColor;\n      text-transform: uppercase;\n      font-weight: 800;\n      font-family: 'Newsreader', serif;\n      letter-spacing: 0.1em;\n      mix-blend-mode: multiply;\n      opacity: 0.75;\n      transform: rotate(var(--rot, -2deg));\n    }\n    .ink-stamp::before {\n      content: attr(data-text);\n      position: absolute;\n      inset: -1px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      color: inherit;\n      filter: blur(2px);\n      opacity: 0.3;\n      pointer-events: none;\n    }\n    .ink-stamp::after {\n      content: \"\";\n      position: absolute;\n      inset: 0;\n      background-image: url('https://www.transparenttextures.com/patterns/stardust.png');\n      opacity: 0.4;\n      mix-blend-mode: multiply;\n    }\n\n    .reveal-item { opacity: 1; }\n\n    /* Grid Paper Pattern */\n    .grid-paper-pattern {\n      background-image: \n        linear-gradient(rgba(0,0,0,0.05) 1px, transparent 1px),\n        linear-gradient(90deg, rgba(0,0,0,0.05) 1px, transparent 1px);\n      background-size: 20px 20px;\n    }\n\n    .hairline-rule { border-bottom: 1px solid rgba(0,0,0,0.1); }\n    .heavy-rule { border-bottom: 3px solid var(--dark-coffee); }\n\n    /* Custom Scrollbar for the skeuomorphic look */\n    ::-webkit-scrollbar { width: 8px; }\n    ::-webkit-scrollbar-track { background: var(--parchment); }\n    ::-webkit-scrollbar-thumb { background: var(--dark-coffee); }\n\n    /* Clipboard Stylings */\n    .clipboard-callout {\n        background: #fffefb;\n        box-shadow: \n            0 1px 1px rgba(0,0,0,0.1),\n            0 15px 35px rgba(0,0,0,0.3);\n        border-top: 12px solid #2d1f16;\n        padding: 2rem 1.5rem 1.5rem;\n        position: relative;\n        background-image: url('https://www.transparenttextures.com/patterns/paper-fibers.png');\n    }\n    .clipboard-clip {\n        position: absolute;\n        top: -30px;\n        left: 50%;\n        transform: translateX(-50%);\n        width: 90px;\n        height: 50px;\n        background: linear-gradient(180deg, #999 0%, #444 100%);\n        border-radius: 6px 6px 2px 2px;\n        box-shadow: \n            0 4px 6px rgba(0,0,0,0.4),\n            inset 0 1px 2px rgba(255,255,255,0.3);\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        border: 1px solid #333;\n    }\n    .clipboard-clip-handle {\n        width: 45px;\n        height: 12px;\n        background: #222;\n        border-radius: 10px;\n        box-shadow: inset 0 2px 4px rgba(0,0,0,0.8);\n        position: relative;\n    }\n    .clipboard-clip-handle::after {\n        content: \"\";\n        position: absolute;\n        top: 2px;\n        left: 50%;\n        transform: translateX(-50%);\n        width: 30px;\n        height: 2px;\n        background: #444;\n        border-radius: 1px;\n    }\n  </style>\n\n  \n  <aside class=\"w-84 leather-sidebar flex-shrink-0 min-h-screen border-r-[3px] border-black sticky top-0 h-screen flex flex-col z-50\" data-kid=\"2\">\n    <div class=\"relative z-10 p-10 flex flex-col h-full\" data-kid=\"3\">\n      \n      <div class=\"mb-16\" data-kid=\"4\">\n        <h1 class=\"font-serif-heading text-4xl font-black text-white/90 tracking-tighter uppercase leading-none drop-shadow-[0_2px_0_rgba(0,0,0,0.5)]\" data-kid=\"5\">\n            MADCO<br data-kid=\"6\"><span class=\"text-[var(--gold)]\" data-kid=\"7\">TRUCK PLAZA</span>\n        </h1>\n        <div class=\"h-px w-full bg-white/20 mt-4\" data-kid=\"8\"></div>\n        <p class=\"text-[10px] uppercase tracking-[0.3em] text-white/40 font-bold mt-2\" data-kid=\"9\">Logistics Master Ledger</p>\n      </div>\n\n      \n      <nav class=\"space-y-8\" data-kid=\"10\">\n        <a href=\"#\" class=\"group block font-serif-heading text-xl italic text-[#D4AF37] transition-all hover:translate-x-1 drop-shadow-[0_1px_2px_rgba(0,0,0,0.8)]\" data-kid=\"11\">\n          <span class=\"inline-block text-xs mr-3\" data-kid=\"12\">✦</span>\n          The Master Ledger\n        </a>\n        <a href=\"#\" class=\"group block font-serif-heading text-xl text-white/60 hover:text-white transition-all hover:translate-x-1 hover:drop-shadow-[0_1px_2px_rgba(0,0,0,0.4)]\" data-kid=\"13\">\n          <span class=\"inline-block text-xs mr-3 opacity-20 group-hover:opacity-100\" data-kid=\"14\">✧</span>\n          Daily Manifest\n        </a>\n        <a href=\"#\" class=\"group block font-serif-heading text-xl text-white/60 hover:text-white transition-all hover:translate-x-1\" data-kid=\"15\">\n          <span class=\"inline-block text-xs mr-3 opacity-20 group-hover:opacity-100\" data-kid=\"16\">✧</span>\n          Issue Pass\n        </a>\n        <a href=\"#\" class=\"group block font-serif-heading text-xl text-white/60 hover:text-white transition-all hover:translate-x-1\" data-kid=\"17\">\n          <span class=\"inline-block text-xs mr-3 opacity-20 group-hover:opacity-100\" data-kid=\"18\">✧</span>\n          Monthly Customers\n        </a>\n        <a href=\"#\" class=\"group block font-serif-heading text-xl text-white/60 hover:text-white transition-all hover:translate-x-1\" data-kid=\"19\">\n          <span class=\"inline-block text-xs mr-3 opacity-20 group-hover:opacity-100\" data-kid=\"20\">✧</span>\n          Lot Analytics\n        </a>\n      </nav>\n\n      <div class=\"mt-auto pt-10\" data-kid=\"21\">\n        \n        <div class=\"clipboard-callout mt-12 group hover:-translate-y-1 transition-transform cursor-default\" data-kid=\"22\">\n          <div class=\"clipboard-clip\" data-kid=\"23\">\n              <div class=\"clipboard-clip-handle\" data-kid=\"24\"></div>\n          </div>\n          <div class=\"flex items-center justify-between mb-4 border-b border-black/20 pb-2\" data-kid=\"25\">\n            <h4 class=\"font-serif-heading font-bold text-sm text-[var(--dark-coffee)]\" data-kid=\"26\">OFFICE MEMORANDUM</h4>\n            <div class=\"w-1.5 h-1.5 bg-[var(--mahogany)] rounded-full animate-pulse\" data-kid=\"27\"></div>\n          </div>\n          <div class=\"space-y-4\" data-kid=\"28\">\n            <div class=\"flex items-start gap-2 text-xs leading-relaxed text-[var(--dark-coffee)]/80\" data-kid=\"29\">\n                <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/bookmark.svg\" class=\"w-4 h-4 shrink-0\" style=\"color: var(--dark-coffee);\" data-kid=\"30\">\n                <p data-kid=\"31\"><strong data-kid=\"32\">Wilson Logistics:</strong> Identified 12 daily entries. Propose <strong data-kid=\"33\">Monthly Plan</strong>.</p>\n            </div>\n            <div class=\"flex items-start gap-2 text-xs leading-relaxed text-[var(--dark-coffee)]/80\" data-kid=\"34\">\n                <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/bookmark.svg\" class=\"w-4 h-4 shrink-0\" style=\"color: var(--dark-coffee);\" data-kid=\"35\">\n                <p data-kid=\"36\"><strong data-kid=\"37\">VIP Status:</strong> Swift Lines verified 100% renewal. Issue <strong data-kid=\"38\">VIP Card</strong>.</p>\n            </div>\n          </div>\n          <button class=\"mt-4 w-full py-2 bg-[var(--dark-coffee)] text-[#f0ead6] text-[10px] uppercase tracking-widest font-bold border border-black/20 shadow-lg active:shadow-inner hover:brightness-110 transition-all\" data-kid=\"39\">\n            Review Suggestions\n          </button>\n        </div>\n      </div>\n    </div>\n  </aside>\n\n  \n  <main class=\"flex-1 paper-texture min-h-screen relative overflow-x-clip\" data-kid=\"40\">\n    <div class=\"max-w-6xl mx-auto p-16 pt-12 space-y-20\" data-scroll-section data-kid=\"41\">\n      \n      \n      <header class=\"text-center relative reveal-item\" data-scroll style=\"--i: 0\" data-kid=\"42\">\n        <div class=\"flex justify-between items-end mb-4 font-serif-heading italic text-xs tracking-widest uppercase opacity-70 border-b border-black/10 pb-2\" data-kid=\"43\">\n          <div class=\"flex gap-6\" data-kid=\"44\">\n            <span data-kid=\"45\">Volume XLIX</span>\n            <span data-kid=\"46\">Issue No. 204</span>\n          </div>\n          <div class=\"text-center flex-1\" data-kid=\"47\">\n              <span class=\"tracking-[0.5em] text-sm font-bold\" data-kid=\"48\">Madco Truck Plaza • Est. 1974</span>\n          </div>\n          <div class=\"flex gap-6\" data-kid=\"49\">\n            <span data-kid=\"50\">Wednesday</span>\n            <span data-kid=\"51\">July 3, 2024</span>\n          </div>\n        </div>\n        <div class=\"border-y-[3px] border-[var(--dark-coffee)] py-6 mb-8\" data-kid=\"52\">\n            <h2 class=\"font-serif-heading text-[6.5rem] font-black uppercase tracking-[-0.02em] leading-[0.9] text-[var(--dark-coffee)]\" data-kid=\"53\">\n              The Master Ledger\n            </h2>\n        </div>\n        <div class=\"flex items-center justify-between px-2\" data-kid=\"54\">\n          <span class=\"text-[10px] uppercase tracking-[0.3em] font-bold opacity-40\" data-kid=\"55\">Detroit Metropolitan Area</span>\n          <p class=\"font-serif-heading text-xl italic opacity-70\" data-kid=\"56\">\"Efficiency in Logistics, Integrity in Service\"</p>\n          <span class=\"text-[10px] uppercase tracking-[0.3em] font-bold opacity-40\" data-kid=\"57\">Romulus, Michigan</span>\n        </div>\n      </header>\n\n      \n      <section class=\"grid grid-cols-4 gap-0 border-[3px] border-[var(--dark-coffee)] bg-[#fffefb] shadow-2xl relative overflow-hidden reveal-item\" data-scroll style=\"--i: 1\" data-kid=\"58\">\n        <div class=\"absolute inset-0 opacity-[0.03] pointer-events-none bg-[url('https://www.transparenttextures.com/patterns/paper-fibers.png')]\" data-kid=\"59\"></div>\n        <div class=\"p-10 border-r-[1px] border-[var(--dark-coffee)] group relative\" data-kid=\"60\">\n          <span class=\"text-[10px] uppercase tracking-[0.2em] opacity-40 mb-2 block\" data-kid=\"61\">Today's Revenue</span>\n          <div class=\"flex items-baseline gap-1\" data-kid=\"62\">\n            <span class=\"font-serif-heading text-4xl font-bold text-[var(--emerald)]\" data-kid=\"63\">$4,280</span>\n            <span class=\"text-sm opacity-60\" data-kid=\"64\">.45</span>\n          </div>\n          <div class=\"mt-4 flex items-center gap-2 text-[10px] font-bold text-[var(--emerald)]/60\" data-kid=\"65\">\n            <span data-kid=\"66\">§</span>\n            <span data-kid=\"67\">+12% vs. Last Wed</span>\n          </div>\n        </div>\n        <div class=\"p-10 border-r-[1px] border-[var(--dark-coffee)] bg-[var(--parchment)]/30 relative\" data-kid=\"68\">\n          <div class=\"absolute top-2 right-2 opacity-10 text-4xl\" data-kid=\"69\">®</div>\n          <span class=\"text-[10px] uppercase tracking-[0.2em] opacity-40 mb-2 block\" data-kid=\"70\">Active Vehicles</span>\n          <span class=\"font-serif-heading text-5xl font-bold\" data-kid=\"71\">142</span>\n          <p class=\"text-[10px] mt-2 opacity-60 font-serif-heading italic\" data-kid=\"72\">Verified Manifest Count</p>\n        </div>\n        <div class=\"p-10 border-r-[1px] border-[var(--dark-coffee)]\" data-kid=\"73\">\n          <span class=\"text-[10px] uppercase tracking-[0.2em] opacity-40 mb-2 block\" data-kid=\"74\">Lot Capacity</span>\n          <span class=\"font-serif-heading text-5xl font-bold\" data-kid=\"75\">71%</span>\n          <p class=\"text-[10px] mt-2 opacity-60 text-[var(--mahogany)] font-bold uppercase tracking-widest\" data-kid=\"76\">58 SPACES REMAINING</p>\n        </div>\n        <div class=\"p-10\" data-kid=\"77\">\n          <span class=\"text-[10px] uppercase tracking-[0.2em] opacity-40 mb-2 block\" data-kid=\"78\">Expiring Today</span>\n          <span class=\"font-serif-heading text-5xl font-bold text-[var(--mahogany)]\" data-kid=\"79\">14</span>\n          <p class=\"text-[10px] mt-2 opacity-60 italic font-serif-heading\" data-kid=\"80\">Follow-up mandatory</p>\n        </div>\n      </section>\n\n      \n      <section class=\"space-y-6 reveal-item\" data-scroll style=\"--i: 2\" data-kid=\"81\">\n        <div class=\"flex items-center justify-between border-b border-black/10 pb-4\" data-kid=\"82\">\n            <h3 class=\"font-serif-heading text-3xl font-bold flex items-center gap-4\" data-kid=\"83\">\n                <span class=\"text-[var(--gold)]\" data-kid=\"84\">¶</span>\n                Live Lot Occupancy Map\n            </h3>\n            <div class=\"flex items-center gap-6 text-[11px] uppercase tracking-widest font-bold font-serif-heading\" data-kid=\"85\">\n                <div class=\"flex items-center gap-2\" data-kid=\"86\">\n                    <div class=\"w-3 h-3 bg-[var(--emerald)] border border-black/30\" data-kid=\"87\"></div>\n                    <span class=\"opacity-50\" data-kid=\"88\">Occupied</span>\n                </div>\n                <div class=\"flex items-center gap-2\" data-kid=\"89\">\n                    <div class=\"w-3 h-3 bg-white border border-black/10\" data-kid=\"90\"></div>\n                    <span class=\"opacity-50\" data-kid=\"91\">Available</span>\n                </div>\n                <div class=\"flex items-center gap-2\" data-kid=\"92\">\n                    <div class=\"w-3 h-3 bg-[var(--mahogany)] border border-black/30\" data-kid=\"93\"></div>\n                    <span class=\"opacity-50\" data-kid=\"94\">Unavailable</span>\n                </div>\n            </div>\n        </div>\n        <div class=\"grid-paper-pattern border-[3px] border-[var(--dark-coffee)] shadow-[inset_0_10px_30px_rgba(0,0,0,0.05)] bg-white/20 min-h-[320px]\" data-kid=\"95\">\n            <div id=\"occupancy-grid\" class=\"flex flex-wrap gap-[4px] content-start p-10 h-full\" data-kid=\"96\">\n                \n            </div>\n        </div>\n      </section>\n\n      \n      <section class=\"space-y-6 reveal-item\" data-scroll style=\"--i: 3\" data-kid=\"97\">\n        <h3 class=\"font-serif-heading text-3xl font-bold flex items-center gap-4\" data-kid=\"98\">\n            <span class=\"text-[var(--gold)]\" data-kid=\"99\">§</span>\n            Recent Manifest Entries\n        </h3>\n        <div class=\"border-t-[3px] border-[var(--dark-coffee)]\" data-kid=\"100\">\n          \n          \n          <div class=\"flex items-center justify-between py-6 hairline-rule group hover:bg-black/[0.03] transition-colors px-4 relative overflow-hidden reveal-item\" data-scroll style=\"--i: 4\" data-kid=\"101\">\n            <div class=\"w-48\" data-kid=\"102\">\n                <span class=\"text-[10px] uppercase tracking-widest opacity-40 block mb-1\" data-kid=\"103\">Company</span>\n                <span class=\"font-serif-heading text-xl font-bold\" data-kid=\"104\">Prime Inc.</span>\n            </div>\n            <div class=\"w-32\" data-kid=\"105\">\n                <span class=\"text-[10px] uppercase tracking-widest opacity-40 block mb-1\" data-kid=\"106\">Truck #</span>\n                <span class=\"text-lg\" data-kid=\"107\">88421</span>\n            </div>\n            <div class=\"w-32\" data-kid=\"108\">\n                <span class=\"text-[10px] uppercase tracking-widest opacity-40 block mb-1\" data-kid=\"109\">Pass Type</span>\n                <span class=\"text-lg italic opacity-80\" data-kid=\"110\">Weekly</span>\n            </div>\n            <div class=\"w-48 text-right\" data-kid=\"111\">\n                <span class=\"text-[10px] uppercase tracking-widest opacity-40 block mb-1\" data-kid=\"112\">Status</span>\n                <div class=\"ink-stamp text-[var(--emerald)] rotate-[-2deg] text-xs\" data-text=\"ACTIVE\" data-kid=\"113\">ACTIVE</div>\n            </div>\n          </div>\n\n          \n          <div class=\"flex items-center justify-between py-6 hairline-rule group hover:bg-black/[0.03] transition-colors px-4 relative overflow-hidden reveal-item\" data-scroll style=\"--i: 5\" data-kid=\"114\">\n            <div class=\"w-48\" data-kid=\"115\">\n                <span class=\"text-[10px] uppercase tracking-widest opacity-40 block mb-1\" data-kid=\"116\">Company</span>\n                <span class=\"font-serif-heading text-xl font-bold\" data-kid=\"117\">Swift Transportation</span>\n            </div>\n            <div class=\"w-32\" data-kid=\"118\">\n                <span class=\"text-[10px] uppercase tracking-widest opacity-40 block mb-1\" data-kid=\"119\">Truck #</span>\n                <span class=\"text-lg\" data-kid=\"120\">22109</span>\n            </div>\n            <div class=\"w-32\" data-kid=\"121\">\n                <span class=\"text-[10px] uppercase tracking-widest opacity-40 block mb-1\" data-kid=\"122\">Pass Type</span>\n                <span class=\"text-lg italic opacity-80\" data-kid=\"123\">Monthly</span>\n            </div>\n            <div class=\"w-48 text-right\" data-kid=\"124\">\n                <span class=\"text-[10px] uppercase tracking-widest opacity-40 block mb-1\" data-kid=\"125\">Status</span>\n                <div class=\"ink-stamp text-[var(--emerald)] rotate-[1deg] text-xs\" data-text=\"PAID\" data-kid=\"126\">PAID</div>\n            </div>\n          </div>\n\n          \n          <div class=\"flex items-center justify-between py-6 hairline-rule group hover:bg-black/[0.03] transition-colors px-4 relative overflow-hidden reveal-item\" data-scroll style=\"--i: 6\" data-kid=\"127\">\n            <div class=\"w-48\" data-kid=\"128\">\n                <span class=\"text-[10px] uppercase tracking-widest opacity-40 block mb-1\" data-kid=\"129\">Company</span>\n                <span class=\"font-serif-heading text-xl font-bold\" data-kid=\"130\">Knight-Swift</span>\n            </div>\n            <div class=\"w-32\" data-kid=\"131\">\n                <span class=\"text-[10px] uppercase tracking-widest opacity-40 block mb-1\" data-kid=\"132\">Truck #</span>\n                <span class=\"text-lg\" data-kid=\"133\">77610</span>\n            </div>\n            <div class=\"w-32\" data-kid=\"134\">\n                <span class=\"text-[10px] uppercase tracking-widest opacity-40 block mb-1\" data-kid=\"135\">Pass Type</span>\n                <span class=\"text-lg italic opacity-80\" data-kid=\"136\">Daily</span>\n            </div>\n            <div class=\"w-48 text-right\" data-kid=\"137\">\n                <span class=\"text-[10px] uppercase tracking-widest opacity-40 block mb-1\" data-kid=\"138\">Status</span>\n                <div class=\"ink-stamp text-[var(--mahogany)] rotate-[-3deg] text-xs\" data-text=\"EXPIRED\" data-kid=\"139\">EXPIRED</div>\n            </div>\n          </div>\n\n          \n          <div class=\"flex items-center justify-between py-6 hairline-rule group hover:bg-black/[0.03] transition-colors px-4 relative overflow-hidden reveal-item\" data-scroll style=\"--i: 7\" data-kid=\"140\">\n            <div class=\"w-48\" data-kid=\"141\">\n                <span class=\"text-[10px] uppercase tracking-widest opacity-40 block mb-1\" data-kid=\"142\">Company</span>\n                <span class=\"font-serif-heading text-xl font-bold\" data-kid=\"143\">Old Dominion</span>\n            </div>\n            <div class=\"w-32\" data-kid=\"144\">\n                <span class=\"text-[10px] uppercase tracking-widest opacity-40 block mb-1\" data-kid=\"145\">Truck #</span>\n                <span class=\"text-lg\" data-kid=\"146\">11400</span>\n            </div>\n            <div class=\"w-32\" data-kid=\"147\">\n                <span class=\"text-[10px] uppercase tracking-widest opacity-40 block mb-1\" data-kid=\"148\">Pass Type</span>\n                <span class=\"text-lg italic opacity-80\" data-kid=\"149\">Monthly</span>\n            </div>\n            <div class=\"w-48 text-right\" data-kid=\"150\">\n                <span class=\"text-[10px] uppercase tracking-widest opacity-40 block mb-1\" data-kid=\"151\">Status</span>\n                <div class=\"ink-stamp text-[var(--emerald)] rotate-[2deg] text-xs\" data-text=\"HOLDING SPOT\" data-kid=\"152\">HOLDING SPOT</div>\n            </div>\n          </div>\n\n        </div>\n        <div class=\"text-center pt-8\" data-kid=\"153\">\n            <button class=\"font-serif-heading italic text-xl border-b border-[var(--dark-coffee)] hover:opacity-60 transition-opacity\" data-kid=\"154\">View Full Master Ledger Archives</button>\n        </div>\n      </section>\n\n      \n      <footer class=\"pt-20 border-t border-black/10 text-center opacity-40 text-xs uppercase tracking-[0.4em] font-bold\" data-scroll style=\"--i: 8\" data-kid=\"155\">\n        &copy; 2024 Madco Truck Plaza — Official Records — Romulus, Michigan\n      </footer>\n\n    </div>\n  </main>\n\n  \n  <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"156\"></script>\n  <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"157\"></script>\n  <script src=\"https://cdn.jsdelivr.net/npm/locomotive-scroll@5/bundled/locomotive-scroll.min.js\" data-kid=\"158\"></script>\n  <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/locomotive-scroll@5/bundled/locomotive-scroll.css\" data-kid=\"159\">\n\n  <script data-kid=\"160\">\n    gsap.registerPlugin(ScrollTrigger);\n\n    // Initialize Locomotive Scroll (internal Lenis)\n    const locomotiveScroll = new LocomotiveScroll({\n      lenisOptions: {\n        lerp: 0.1,\n        duration: 1.2,\n        smoothWheel: true,\n      }\n    });\n\n    // Generate Occupancy Grid (200 squares)\n    const gridContainer = document.getElementById('occupancy-grid');\n    for (let i = 0; i < 200; i++) {\n      const square = document.createElement('div');\n      square.className = 'w-[18px] h-[18px] border border-black/10 transition-colors duration-500 hover:bg-[var(--gold)]/20 cursor-help';\n      \n      const rand = Math.random();\n      if (rand > 0.6) {\n        square.style.backgroundColor = 'var(--emerald)';\n        square.style.opacity = (Math.random() * 0.4 + 0.6).toString();\n      } else if (rand < 0.1) {\n        square.style.backgroundColor = 'var(--mahogany)';\n        square.style.opacity = (Math.random() * 0.3 + 0.4).toString();\n      } else {\n        square.style.backgroundColor = 'rgba(255,255,255,0.4)';\n      }\n      \n      gridContainer.appendChild(square);\n    }\n\n    // GSAP Mechanical Stagger Reveal\n    gsap.set(\"[data-scroll]\", { opacity: 0, y: 40 });\n    \n    ScrollTrigger.batch(\"[data-scroll]\", {\n      onEnter: batch => gsap.to(batch, {\n        opacity: 1, \n        y: 0, \n        stagger: 0.15, \n        duration: 1, \n        ease: \"power3.out\",\n        overwrite: true\n      }),\n      start: \"top 95%\"\n    });\n\n    // Sync Locomotive with GSAP ScrollTrigger\n    locomotiveScroll.on('scroll', ScrollTrigger.update);\n    ScrollTrigger.refresh();\n  </script>\n</div>\n",
      "comments": [],
      "created": "2026-07-03T14:54:30.812695+00:00",
      "modified": "2026-07-03T14:54:30.812695+00:00",
      "id": "var_0d1796464303"
    },
    "var_288ac5e1f27e": {
      "type": "variant",
      "label": "Dashboard: Peterbilt Console",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "\n<div class=\"industrial-bg font-['Fira_Sans'] text-[#e0e0e0] min-h-screen\" data-kid=\"0\">\n    <style data-kid=\"1\">\n        @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Fira+Sans:wght@300;400;500;600&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n        :root {\n            --color-iron-grey: #414A4C;\n            --color-deep-navy: #011F5B;\n            --color-flame-orange: #FF4F00;\n            --color-lime-green: #32CD32;\n            --color-gold: #d4a843;\n        }\n\n        .industrial-bg {\n            background-color: var(--color-iron-grey);\n            background-image: url('https://images.pexels.com/photos/5308536/pexels-photo-5308536.jpeg?auto=compress&cs=tinysrgb&w=1440&q=80');\n            background-size: cover;\n            background-attachment: fixed;\n            background-position: center;\n        }\n\n        .neomorph-inset-navy {\n            background: #021435;\n            border-radius: 8px;\n            box-shadow: \n                inset 8px 8px 24px rgba(0,0,0,1),\n                inset -2px -2px 10px rgba(255,255,255,0.05),\n                0 10px 30px rgba(0,0,0,0.8);\n            border: 6px solid #14202c;\n            position: relative;\n            overflow: hidden;\n        }\n\n        .screen-overlay {\n            position: absolute;\n            top: 0; left: 0; right: 0; bottom: 0;\n            background: repeating-linear-gradient(\n                0deg,\n                rgba(0, 0, 0, 0.12),\n                rgba(0, 0, 0, 0.12) 1px,\n                transparent 1px,\n                transparent 2px\n            );\n            pointer-events: none;\n            opacity: 0.6;\n            z-index: 10;\n        }\n\n        .heavy-tab {\n            position: relative;\n            background: linear-gradient(to bottom, #4f5a5c, #2d3537);\n            border: 1px solid #1a1f21;\n            border-bottom: none;\n            padding: 0.7rem 2rem;\n            margin-right: 0; /* Contiguous bar */\n            cursor: pointer;\n            font-family: 'Space Grotesk', sans-serif;\n            font-weight: 700;\n            text-transform: uppercase;\n            letter-spacing: 0.08em;\n            color: #88929b;\n            clip-path: polygon(10% 0%, 90% 0%, 100% 100%, 0% 100%);\n            font-size: 0.75rem;\n            flex: 1;\n            text-align: center;\n        }\n\n        .heavy-tab.active {\n            background: linear-gradient(to bottom, #5a6668, #414a4c);\n            color: var(--color-flame-orange);\n            z-index: 10;\n            border-top: 2px solid var(--color-flame-orange);\n        }\n\n        .orange-glow-line {\n            position: absolute;\n            bottom: 0;\n            left: 20%;\n            right: 20%;\n            height: 4px;\n            background: var(--color-flame-orange);\n            box-shadow: 0 0 25px 5px var(--color-flame-orange);\n        }\n\n        .rocker-switch {\n            background: linear-gradient(to bottom, #555f62, #1a2022);\n            border: 2px solid #101517;\n            padding: 16px 28px;\n            border-radius: 4px;\n            font-family: 'Space Grotesk', sans-serif;\n            font-weight: 700;\n            text-transform: uppercase;\n            color: #d1d5db;\n            box-shadow: \n                inset 0 1px 0 rgba(255,255,255,0.1),\n                0 8px 0 #0d1214,\n                0 15px 25px rgba(0,0,0,0.8);\n            cursor: pointer;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            gap: 14px;\n            user-select: none;\n        }\n\n        .rocker-switch:active {\n            transform: translateY(6px);\n            box-shadow: \n                inset 0 1px 0 rgba(255,255,255,0.1),\n                0 2px 0 #0d1214,\n                0 5px 15px rgba(0,0,0,0.8);\n        }\n\n        .double-frame {\n            border: 3px solid var(--color-gold);\n            padding: 4px;\n            position: relative;\n            display: inline-block;\n            background: #3a4446;\n            box-shadow: 0 4px 10px rgba(0,0,0,0.4);\n        }\n        .double-frame-inner {\n            border: 1px solid rgba(212, 168, 67, 0.4);\n            padding: 10px 24px;\n            color: var(--color-gold);\n            font-weight: 700;\n            font-family: 'Space Grotesk', sans-serif;\n            text-transform: uppercase;\n            letter-spacing: 0.12em;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            gap: 10px;\n        }\n\n        .ridge-border {\n            border: 5px ridge rgba(255,255,255,0.1);\n            background: rgba(50, 58, 60, 0.9);\n            box-shadow: 10px 10px 30px rgba(0,0,0,0.5), inset 2px 2px 4px rgba(255,255,255,0.05);\n        }\n\n        .bolt {\n            width: 14px;\n            height: 14px;\n            background: radial-gradient(circle at 35% 35%, #ddd, #222);\n            border-radius: 50%;\n            box-shadow: \n                inset 2px 2px 4px rgba(255,255,255,0.2),\n                2px 2px 6px rgba(0,0,0,0.8);\n            position: absolute;\n        }\n\n        .gauge-meter {\n            position: relative;\n            width: 360px;\n            height: 180px;\n            overflow: hidden;\n        }\n        .gauge-background {\n            width: 360px;\n            height: 360px;\n            border-radius: 50%;\n            border: 30px solid #08101a;\n            border-bottom-color: transparent;\n            border-left-color: transparent;\n            transform: rotate(-135deg);\n        }\n        .gauge-progress {\n            position: absolute;\n            top: 0; left: 0;\n            width: 360px;\n            height: 360px;\n            border-radius: 50%;\n            border: 30px solid var(--color-lime-green);\n            border-bottom-color: transparent;\n            border-left-color: transparent;\n            transform: rotate(-135deg);\n            filter: drop-shadow(0 0 15px var(--color-lime-green));\n            /* Transition removed for GSAP */\n        }\n\n        .led-indicator {\n            width: 16px;\n            height: 16px;\n            border-radius: 50%;\n            background: var(--color-flame-orange);\n            box-shadow: 0 0 15px var(--color-flame-orange), inset 0 0 5px rgba(0,0,0,0.5);\n            display: inline-block;\n            border: 1px solid rgba(255,255,255,0.2);\n        }\n\n        .digital-readout {\n            font-family: 'Space Grotesk', sans-serif;\n            background: #000;\n            color: var(--color-lime-green);\n            text-shadow: 0 0 10px var(--color-lime-green);\n            padding: 10px 18px;\n            border: 4px solid #1a1a1a;\n            box-shadow: inset 0 0 15px rgba(50, 205, 50, 0.3);\n            font-weight: 700;\n        }\n\n        .crt-flicker {\n            animation: flicker 0.15s infinite;\n        }\n\n        @keyframes flicker {\n            0% { opacity: 0.95; }\n            50% { opacity: 1; }\n            100% { opacity: 0.98; }\n        }\n\n        .custom-scrollbar::-webkit-scrollbar {\n            width: 4px;\n        }\n        .custom-scrollbar::-webkit-scrollbar-track {\n            background: rgba(0,0,0,0.3);\n        }\n        .custom-scrollbar::-webkit-scrollbar-thumb {\n            background: var(--color-iron-grey);\n            border-radius: 2px;\n        }\n\n        .stat-bar-container {\n            background: #04080e;\n            border: 4px solid #101824;\n            height: 180px;\n            display: flex;\n            align-items: flex-end;\n            padding: 1rem;\n            gap: 1.5rem;\n            position: relative;\n        }\n\n        .stat-bar {\n            flex: 1;\n            background: linear-gradient