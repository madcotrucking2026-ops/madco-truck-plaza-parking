<h2 class=\"font-['Space_Grotesk'] text-gray-400 text-xs font-black tracking-[0.3em] uppercase\" data-kid=\"117\">Revenue Velocity (7D Matrix)</h2>\n                            <div class=\"flex items-center gap-3\" data-kid=\"118\">\n                                <i class=\"ti ti-trending-up text-[var(--color-lime-green)]\" data-kid=\"119\"></i>\n                                <span class=\"text-[10px] font-mono text-[var(--color-lime-green)] font-bold tracking-widest\" data-kid=\"120\">+18.4% GAIN</span>\n                            </div>\n                        </div>\n                        <div class=\"flex-1 flex items-end justify-between gap-3 px-8\" data-kid=\"121\">\n                            <div class=\"flex-1 chart-segment rounded-t-[2px]\" style=\"height: 40%;\" data-kid=\"122\"></div>\n                            <div class=\"flex-1 chart-segment rounded-t-[2px]\" style=\"height: 55%;\" data-kid=\"123\"></div>\n                            <div class=\"flex-1 chart-segment rounded-t-[2px]\" style=\"height: 48%;\" data-kid=\"124\"></div>\n                            <div class=\"flex-1 chart-segment rounded-t-[2px] border-t-white shadow-[0_0_15px_rgba(255,255,255,0.2)]\" style=\"height: 85%;\" data-kid=\"125\"></div>\n                            <div class=\"flex-1 chart-segment rounded-t-[2px]\" style=\"height: 62%;\" data-kid=\"126\"></div>\n                            <div class=\"flex-1 chart-segment chart-segment-alert rounded-t-[2px]\" style=\"height: 95%;\" data-kid=\"127\"></div>\n                            <div class=\"flex-1 chart-segment rounded-t-[2px]\" style=\"height: 35%;\" data-kid=\"128\"></div>\n                        </div>\n                        <div class=\"flex justify-between px-8 mt-5\" data-kid=\"129\">\n                            <span class=\"text-[10px] font-black text-gray-500 uppercase tracking-widest\" data-kid=\"130\">Mon</span>\n                            <span class=\"text-[10px] font-black text-gray-500 uppercase tracking-widest\" data-kid=\"131\">Tue</span>\n                            <span class=\"text-[10px] font-black text-gray-500 uppercase tracking-widest\" data-kid=\"132\">Wed</span>\n                            <span class=\"text-[10px] font-black text-gray-500 uppercase tracking-widest\" data-kid=\"133\">Thu</span>\n                            <span class=\"text-[10px] font-black text-gray-500 uppercase tracking-widest\" data-kid=\"134\">Fri</span>\n                            <span class=\"text-[10px] font-black text-gray-100 uppercase tracking-[0.2em] font-bold\" data-kid=\"135\">SAT</span>\n                            <span class=\"text-[10px] font-black text-gray-500 uppercase tracking-widest\" data-kid=\"136\">Sun</span>\n                        </div>\n                    </div>\n                </section>\n            </div>\n\n            \n            <div class=\"col-span-12 lg:col-span-3 flex flex-col gap-8\" data-kid=\"137\">\n                \n                \n                <section class=\"ridge-border p-10 rounded-lg bg-[#3a4446] flex flex-col h-full shadow-2xl\" data-kid=\"138\">\n                    <h2 class=\"font-['Space_Grotesk'] text-gray-400 text-xs font-black tracking-[0.3em] uppercase mb-12 border-b border-gray-600/30 pb-4 flex items-center justify-between\" data-kid=\"139\">\n                        <span data-kid=\"140\">Registry Delta</span>\n                        <i class=\"ti ti-chart-bar-popular text-gray-500 text-lg\" data-kid=\"141\"></i>\n                    </h2>\n                    \n                    <div class=\"stat-bar-container rounded-sm flex-1\" data-kid=\"142\">\n                        <div class=\"stat-bar\" style=\"height: 100%; border-top-color: var(--color-lime-green);\" data-kid=\"143\">\n                            <span class=\"text-[10px] font-black text-gray-400 uppercase tracking-widest absolute bottom-full mb-3\" data-kid=\"144\">Daily</span>\n                            <span class=\"text-4xl font-black font-['Space_Grotesk'] text-white\" data-kid=\"145\">124</span>\n                        </div>\n                        <div class=\"stat-bar\" style=\"height: 70%; border-top-color: var(--color-gold);\" data-kid=\"146\">\n                            <span class=\"text-[10px] font-black text-gray-400 uppercase tracking-widest absolute bottom-full mb-3\" data-kid=\"147\">Weekly</span>\n                            <span class=\"text-4xl font-black font-['Space_Grotesk'] text-white\" data-kid=\"148\">82</span>\n                        </div>\n                        <div class=\"stat-bar\" style=\"height: 45%; border-top-color: var(--color-flame-orange);\" data-kid=\"149\">\n                            <span class=\"text-[10px] font-black text-gray-400 uppercase tracking-widest absolute bottom-full mb-3\" data-kid=\"150\">Monthly</span>\n                            <span class=\"text-4xl font-black font-['Space_Grotesk'] text-white\" data-kid=\"151\">45</span>\n                        </div>\n                    </div>\n\n                    <div class=\"mt-14 pt-8 border-t border-gray-600/30\" data-kid=\"152\">\n                        <div class=\"flex items-center justify-between bg-black/40 p-5 rounded-sm border border-white/5 shadow-inner\" data-kid=\"153\">\n                            <div data-kid=\"154\">\n                                <span class=\"block text-[11px] text-gray-500 font-black uppercase tracking-[0.2em] mb-1\" data-kid=\"155\">Aggregate Load</span>\n                                <span class=\"text-2xl font-black text-white tracking-tighter font-['Space_Grotesk']\" data-kid=\"156\">251 UNITS</span>\n                            </div>\n                            <div class=\"text-right\" data-kid=\"157\">\n                                <span class=\"text-[12px] text-[var(--color-lime-green)] font-mono font-black\" data-kid=\"158\">+8.4%</span>\n                                <i class=\"ti ti-arrow-up-right text-[var(--color-lime-green)] ml-1\" data-kid=\"159\"></i>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n\n                \n                <section class=\"neomorph-inset-navy p-10 flex flex-col justify-between tech-grid\" data-kid=\"160\">\n                    <div class=\"screen-overlay\" data-kid=\"161\"></div>\n                    <div class=\"relative z-20\" data-kid=\"162\">\n                        <h2 class=\"font-['Space_Grotesk'] text-gray-400 text-xs font-black tracking-[0.3em] uppercase mb-10 flex items-center gap-4\" data-kid=\"163\">\n                            <i class=\"ti ti-broadcast text-lime-500\" data-kid=\"164\"></i> Live Telemetry\n                        </h2>\n                        <div class=\"font-mono text-[12px] space-y-4 text-lime-400/80\" data-kid=\"165\">\n                            <div class=\"flex items-start gap-3\" data-kid=\"166\">\n                                <span class=\"text-gray-600 font-bold shrink-0\" data-kid=\"167\">[14:22]</span>\n                                <p class=\"leading-tight\" data-kid=\"168\">SMS_REMINDER_SEQ: #8291 -> SUCCESS_TX</p>\n                            </div>\n                            <div class=\"flex items-start gap-3\" data-kid=\"169\">\n                                <span class=\"text-gray-600 font-bold shrink-0\" data-kid=\"170\">[14:21]</span>\n                                <p class=\"leading-tight\" data-kid=\"171\">ENTRY_VALIDATION: TRUCK_1102 -> AUTH_PASS</p>\n                            </div>\n                            <div class=\"flex items-start gap-3\" data-kid=\"172\">\n                                <span class=\"text-gray-600 font-bold shrink-0\" data-kid=\"173\">[14:18]</span>\n                                <p class=\"leading-tight\" data-kid=\"174\">SPOOLER: PASS_EXT_ROMULUS -> READY</p>\n                            </div>\n                            <div class=\"flex items-start gap-3\" data-kid=\"175\">\n                                <span class=\"text-gray-600 font-bold shrink-0\" data-kid=\"176\">[14:15]</span>\n                                <p class=\"leading-tight\" data-kid=\"177\">UPLINK: NODE_CENTRAL -> CONNECTED</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"relative z-20 mt-10\" data-kid=\"178\">\n                        <button class=\"w-full h-14 border border-white/10 bg-white/5 rounded-sm text-[11px] font-black uppercase tracking-[0.3em] text-gray-400 hover:text-white hover:bg-white/10 transition-all duration-300 flex items-center justify-center gap-4 group\" data-kid=\"179\">\n                            Full Diagnostics <i class=\"ti ti-activity-heartbeat group-hover:scale-125 transition-transform text-lg\" data-kid=\"180\"></i>\n                        </button>\n                    </div>\n                </section>\n            </div>\n        </main>\n\n        \n        <footer class=\"mt-10 ridge-border p-6 bg-[#2d3537] rounded-sm flex flex-col md:flex-row items-center justify-between shadow-2xl relative\" data-kid=\"181\">\n            <div class=\"bolt top-3 left-3 w-2 h-2 opacity-20\" data-kid=\"182\"></div>\n            <div class=\"bolt top-3 right-3 w-2 h-2 opacity-20\" data-kid=\"183\"></div>\n            <div class=\"bolt bottom-3 left-3 w-2 h-2 opacity-20\" data-kid=\"184\"></div>\n            <div class=\"bolt bottom-3 right-3 w-2 h-2 opacity-20\" data-kid=\"185\"></div>\n\n            <div class=\"flex items-center gap-10\" data-kid=\"186\">\n                <div class=\"flex flex-col\" data-kid=\"187\">\n                    <span class=\"text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]\" data-kid=\"188\">Environment State</span>\n                    <span class=\"text-[11px] font-mono text-gray-400 uppercase tracking-widest font-black mt-1\" data-kid=\"189\">SECURE_PROD // CLUSTER_01</span>\n                </div>\n                <div class=\"h-10 w-px bg-white/10\" data-kid=\"190\"></div>\n                <div class=\"flex flex-col\" data-kid=\"191\">\n                    <span class=\"text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]\" data-kid=\"192\">Geographic Lock</span>\n                    <span class=\"text-[11px] font-mono text-gray-400 uppercase tracking-widest font-black mt-1\" data-kid=\"193\">42.2272° N | 83.3594° W</span>\n                </div>\n            </div>\n\n            <div class=\"flex items-center gap-10 mt-6 md:mt-0\" data-kid=\"194\">\n                <div class=\"flex items-center gap-4\" data-kid=\"195\">\n                    <div class=\"w-3 h-3 rounded-full bg-lime-500 shadow-[0_0_15px_#32CD32] border border-white/20\" data-kid=\"196\"></div>\n                    <span class=\"text-[11px] font-black text-gray-400 uppercase tracking-[0.3em]\" data-kid=\"197\">Telemetry Active</span>\n                </div>\n                <div class=\"h-10 w-px bg-white/10\" data-kid=\"198\"></div>\n                <p class=\"text-[10px] font-black text-gray-600 uppercase tracking-[0.2em]\" data-kid=\"199\">© 2024 Madco Tactical Control Console</p>\n            </div>\n        </footer>\n    </div>\n\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"200\"></script>\n    <script data-kid=\"201\">\n        document.addEventListener('DOMContentLoaded', () => {\n            const occupancy = 84;\n            const rotation = -135 + (1.8 * occupancy);\n            \n            // 1. Gauge Needle/Progress Animation\n            gsap.to(\"#occupancy-gauge\", {\n                rotation: rotation,\n                duration: 2.5,\n                ease: \"power4.out\",\n                delay: 0.8\n            });\n\n            // Percent Counter\n            const counter = { val: 0 };\n            gsap.to(counter, {\n                val: occupancy,\n                duration: 2.5,\n                delay: 0.8,\n                onUpdate: () => {\n                    document.getElementById(\"occupancy-percent\").innerHTML = Math.round(counter.val) + \"%\";\n                },\n                onComplete: () => {\n                    document.getElementById(\"occupancy-text\").innerHTML = \"STATUS: CRITICAL LOAD\";\n                    document.getElementById(\"occupancy-text\").style.color = \"#FF4F00\";\n                    document.getElementById(\"occupancy-text\").style.textShadow = \"0 0 15px #FF4F00\";\n                }\n            });\n\n            // 2. Alert LED Pulse (#gsap-yoyo-ease)\n            gsap.to(\"#alert-pulse\", {\n                scale: 1.5,\n                opacity: 0.4,\n                backgroundColor: \"#FF4F00\",\n                duration: 1.2,\n                ease: \"power4.in\",\n                easeReverse: \"power4.out\",\n                yoyo: true,\n                repeat: -1\n            });\n\n            // Status LED\n            gsap.to(\"#status-led\", {\n                opacity: 0.7,\n                duration: 1.5,\n                ease: \"sine.inOut\",\n                yoyo: true,\n                repeat: -1\n            });\n\n            // 3. Staggered Stat Bars\n            gsap.from(\".stat-bar\", {\n                height: 0,\n                duration: 2.5,\n                stagger: 0.25,\n                ease: \"power4.out\",\n                delay: 1.2\n            });\n\n            // 4. Subtle screen interactions\n            const screens = document.querySelectorAll('.neomorph-inset-navy');\n            screens.forEach(screen => {\n                screen.addEventListener('mouseenter', () => {\n                    gsap.to(screen, { boxShadow: \"inset 12px 12px 35px rgba(0,0,0,1), 0 15px 45px rgba(0,0,0,0.9)\", duration: 0.6 });\n                });\n                screen.addEventListener('mouseleave', () => {\n                    gsap.to(screen, { boxShadow: \"inset 8px 8px 24px rgba(0,0,0,0.9), 0 10px 30px rgba(0,0,0,0.8)\", duration: 0.6 });\n                });\n            });\n\n            // 5. Global Entrance\n            gsap.from(\".ridge-border, .neomorph-inset-navy\", {\n                autoAlpha: 0,\n                y: 50,\n                duration: 1.5,\n                stagger: 0.2,\n                ease: \"power3.out\"\n            });\n        });\n    </script>\n</div>\n",
