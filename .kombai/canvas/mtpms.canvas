      "html": "\n<section class=\"min-h-screen bg-[#0B132B] flex font-['IBM_Plex_Sans'] text-slate-900 selection:bg-[#FF7900] selection:text-white overflow-x-clip\" data-kid=\"0\">\n    <link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"1\">\n    <style data-kid=\"2\">\n        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=IBM_Plex_Sans:wght@400;500;600;700&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n        /* Skeuomorphic Patterns */\n        .leather-bg {\n            background-image: linear-gradient(rgba(11, 19, 43, 0.85), rgba(11, 19, 43, 0.85)), url('https://images.unsplash.com/photo-1755541608566-0340d4efca0d?auto=format&w=1600&q=80&fit=crop');\n            background-size: cover;\n            background-blend-mode: multiply;\n        }\n\n        .ridge-border { border: 4px ridge rgba(140, 146, 172, 0.35); }\n\n        .neomorph-raised {\n            background-color: #F4F0EC;\n            box-shadow: 12px 12px 30px rgba(0, 0, 0, 0.12), -12px -12px 30px rgba(255, 255, 255, 0.9);\n        }\n\n        .hard-offset {\n            border: 3px solid #1a1a1a;\n            box-shadow: 6px 6px 0 #1a1a1a;\n        }\n\n        .stacked-paper {\n            position: relative;\n            background: #F4F0EC;\n            z-index: 10;\n            border: 1px solid rgba(0,0,0,0.04);\n        }\n        .stacked-paper::before {\n            content: '';\n            position: absolute;\n            inset: 0;\n            bottom: -5px;\n            left: 4px;\n            right: -4px;\n            background: #ebe7e2;\n            border: 1px solid rgba(0,0,0,0.06);\n            z-index: -1;\n            border-radius: 8px;\n        }\n        .stacked-paper::after {\n            content: '';\n            position: absolute;\n            inset: 0;\n            bottom: -10px;\n            left: 8px;\n            right: -8px;\n            background: #e2ded8;\n            border: 1px solid rgba(0,0,0,0.06);\n            z-index: -2;\n            border-radius: 10px;\n        }\n\n        .embossed-btn {\n            background-color: #e8e6e2;\n            border-top: 2px solid rgba(255, 255, 255, 1);\n            border-bottom: 2px solid rgba(0, 0, 0, 0.25);\n            border-left: 2px solid rgba(255, 255, 255, 0.85);\n            border-right: 2px solid rgba(0, 0, 0, 0.2);\n            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7), inset 0 -1px 0 rgba(0, 0, 0, 0.1), 0 8px 12px rgba(0,0,0,0.2);\n        }\n\n        .stamp-seal {\n            border: 2px dashed #8b2d2d;\n            padding: 4px 14px;\n            color: #8b2d2d;\n            font-weight: 900;\n            text-transform: uppercase;\n            letter-spacing: 0.05em;\n            transform: rotate(-12deg);\n            display: inline-block;\n            opacity: 0.8;\n            font-family: 'Playfair Display', serif;\n            mix-blend-mode: multiply;\n            font-size: 0.8rem;\n            line-height: 1.2;\n        }\n        .stamp-active { border-color: #2d8b4e; color: #2d8b4e; }\n        .stamp-warning { border-color: #b86b00; color: #b86b00; }\n\n        .flip-card {\n            background: linear-gradient(to bottom, #1a1a1a 50%, #0a0a0a 50%);\n            border: 1px solid #333;\n            box-shadow: 0 14px 28px rgba(0,0,0,0.6);\n            position: relative;\n        }\n        .flip-card::after {\n            content: '';\n            position: absolute;\n            top: 50%;\n            left: 0;\n            right: 0;\n            height: 1px;\n            background: rgba(0,0,0,0.9);\n            transform: translateY(-50%);\n        }\n\n        .nav-plaque {\n            background: linear-gradient(135deg, #243b55 0%, #0b132b 100%);\n            border: 1px solid rgba(140, 146, 172, 0.35);\n            box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.1), 0 6px 12px rgba(0,0,0,0.5);\n        }\n\n        .polaroid {\n            background: white;\n            padding: 12px 12px 32px 12px;\n            box-shadow: 0 15px 35px rgba(0,0,0,0.2);\n            border: 1px solid #e0e0e0;\n        }\n\n        .washi-tape {\n            background: #FF7900;\n            opacity: 0.75;\n            height: 20px;\n            width: 85px;\n            position: absolute;\n            top: -12px;\n            left: 50%;\n            transform: translateX(-50%) rotate(-5deg);\n            z-index: 10;\n            box-shadow: 0 3px 6px rgba(0,0,0,0.15);\n        }\n\n        /* Custom Scrollbar */\n        ::-webkit-scrollbar { width: 10px; }\n        ::-webkit-scrollbar-track { background: #0B132B; }\n        ::-webkit-scrollbar-thumb { background: #4a5a8a; border-radius: 5px; border: 2px solid #0B132B; }\n\n        .glass-search {\n            background: rgba(255, 255, 255, 0.08);\n            border: 1px solid rgba(255, 255, 255, 0.15);\n            backdrop-filter: blur(10px);\n        }\n    </style>\n\n    \n    <aside class=\"w-80 leather-bg h-screen flex flex-col border-r-4 ridge-border shadow-2xl z-50 fixed left-0\" data-kid=\"3\">\n        <div class=\"p-10\" data-kid=\"4\">\n            <h1 class=\"font-['Playfair_Display'] text-4xl font-black text-white tracking-tighter flex items-center gap-4\" data-kid=\"5\">\n                <i class=\"ti ti-truck-delivery text-[#FF7900]\" data-kid=\"6\"></i>\n                MADCO\n            </h1>\n            <p class=\"text-[#8C92AC] text-[11px] font-black uppercase tracking-[0.4em] mt-3 pl-12 opacity-60\" data-kid=\"7\">Dispatcher Hub</p>\n        </div>\n\n        <div class=\"flex-1 px-6 space-y-8 overflow-y-auto\" data-kid=\"8\">\n            <div data-kid=\"9\">\n                <p class=\"text-[11px] font-black text-[#8C92AC]/40 uppercase tracking-[0.3em] mb-4 ml-6\" data-kid=\"10\">Primary Ledger</p>\n                <nav class=\"space-y-3\" data-kid=\"11\">\n                    <a href=\"#\" class=\"nav-plaque flex items-center gap-5 px-6 py-4 rounded-lg text-white group border-l-4 border-l-[#FF7900]\" data-kid=\"12\">\n                        <i class=\"ti ti-layout-dashboard text-xl text-[#FF7900]\" data-kid=\"13\"></i>\n                        <span class=\"font-bold text-xs uppercase tracking-widest\" data-kid=\"14\">Dispatch Board</span>\n                    </a>\n                    <a href=\"#\" class=\"flex items-center gap-5 px-6 py-4 rounded-lg text-[#8C92AC] hover:text-white transition-colors group\" data-kid=\"15\">\n                        <i class=\"ti ti-ticket text-xl opacity-40 group-hover:opacity-100 transition-opacity\" data-kid=\"16\"></i>\n                        <span class=\"font-bold text-xs uppercase tracking-widest\" data-kid=\"17\">Issue Pass</span>\n                    </a>\n                    <a href=\"#\" class=\"flex items-center gap-5 px-6 py-4 rounded-lg text-[#8C92AC] hover:text-white transition-colors group\" data-kid=\"18\">\n                        <i class=\"ti ti-history text-xl opacity-40 group-hover:opacity-100 transition-opacity\" data-kid=\"19\"></i>\n                        <span class=\"font-bold text-xs uppercase tracking-widest\" data-kid=\"20\">Pass History</span>\n                    </a>\n                </nav>\n            </div>\n\n            <div data-kid=\"21\">\n                <p class=\"text-[11px] font-black text-[#8C92AC]/40 uppercase tracking-[0.3em] mb-4 ml-6\" data-kid=\"22\">Operations</p>\n                <nav class=\"space-y-3\" data-kid=\"23\">\n                    <a href=\"#\" class=\"flex items-center gap-5 px-6 py-4 rounded-lg text-[#8C92AC] hover:text-white transition-colors group\" data-kid=\"24\">\n                        <i class=\"ti ti-scan text-xl opacity-40 group-hover:opacity-100 transition-opacity\" data-kid=\"25\"></i>\n                        <span class=\"font-bold text-xs uppercase tracking-widest\" data-kid=\"26\">Lot Check</span>\n                    </a>\n                    <a href=\"#\" class=\"flex items-center gap-5 px-6 py-4 rounded-lg text-[#8C92AC] hover:text-white transition-colors group\" data-kid=\"27\">\n                        <i class=\"ti ti-users-group text-xl opacity-40 group-hover:opacity-100 transition-opacity\" data-kid=\"28\"></i>\n                        <span class=\"font-bold text-xs uppercase tracking-widest\" data-kid=\"29\">Monthly Accounts</span>\n                    </a>\n                </nav>\n            </div>\n        </div>\n\n        <div class=\"p-8\" data-kid=\"30\">\n            <div class=\"p-6 bg-black/40 rounded-xl border border-white/5 ridge-border relative overflow-hidden group\" data-kid=\"31\">\n                <div class=\"flex items-center gap-5\" data-kid=\"32\">\n                    <div class=\"relative\" data-kid=\"33\">\n                        <img src=\"https://i.pravatar.cc/120?u=nikhil\" class=\"w-14 h-14 rounded-lg border-2 border-[#8C92AC]/30 shadow-2xl\" alt=\"Nikhil\" data-kid=\"34\">\n                        <span class=\"absolute -bottom-1 -right-1 w-4 h-4 bg-emerald-500 border-4 border-[#0B132B] rounded-full\" data-kid=\"35\"></span>\n                    </div>\n                    <div data-kid=\"36\">\n                        <p class=\"text-white text-base font-black tracking-tight\" data-kid=\"37\">Nikhil</p>\n                        <p class=\"text-[#FF7900] text-[10px] font-black uppercase tracking-tighter\" data-kid=\"38\">Chief Dispatcher</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </aside>\n\n    \n    <main class=\"ml-80 flex-1 flex flex-col bg-[#F4F0EC] h-screen overflow-hidden\" data-kid=\"39\">\n        \n        \n        <header class=\"h-24 bg-[#0B132B] flex items-center px-12 gap-12 border-b-4 ridge-border z-40\" data-kid=\"40\">\n            <div class=\"flex-1 max-w-2xl relative\" data-kid=\"41\">\n                <i class=\"ti ti-search absolute left-6 top-1/2 -translate-y-1/2 text-[#8C92AC] text-xl\" data-kid=\"42\"></i>\n                <input type=\"text\" placeholder=\"Search Vehicle #, Carrier, or DOT Number...\" class=\"w-full bg-black/30 border border-white/10 rounded-lg py-4 pl-16 pr-8 text-white placeholder-[#8C92AC]/40 focus:outline-hidden focus:border-[#FF7900] transition-colors font-bold text-sm tracking-wide\" data-kid=\"43\">\n                <div class=\"absolute right-6 top-1/2 -translate-y-1/2 flex gap-3\" data-kid=\"44\">\n                    <kbd class=\"bg-white/5 text-[#8C92AC] px-3 py-1.5 rounded-md text-[11px] border border-white/10 font-black\" data-kid=\"45\">⌘ K</kbd>\n                </div>\n            </div>\n            \n            <div class=\"flex items-center gap-8\" data-kid=\"46\">\n                <button class=\"relative p-3 text-[#8C92AC] hover:text-white transition-colors\" data-kid=\"47\">\n                    <i class=\"ti ti-bell text-2xl\" data-kid=\"48\"></i>\n                    <span class=\"absolute top-2 right-2 w-3 h-3 bg-[#FF7900] rounded-full border-2 border-[#0B132B]\" data-kid=\"49\"></span>\n                </button>\n                <div class=\"h-10 w-px bg-white/10\" data-kid=\"50\"></div>\n                <button class=\"embossed-btn px-8 py-3 rounded-lg font-black text-xs uppercase tracking-widest text-[#0B132B] flex items-center gap-3 active:scale-95 transition-all\" data-kid=\"51\">\n                    <i class=\"ti ti-plus text-base\" data-kid=\"52\"></i> Issue New Pass\n                </button>\n            </div>\n        </header>\n\n        \n        <div class=\"flex-1 overflow-y-auto p-12 pb-32 space-y-16\" data-kid=\"53\">\n            \n            \n            <div class=\"grid grid-cols-12 gap-12\" data-kid=\"54\">\n                \n                \n                <div class=\"col-span-7 neomorph-raised p-12 rounded-3xl border border-black/5 relative overflow-hidden group\" data-kid=\"55\">\n                    <div class=\"flex justify-between items-start relative z-10\" data-kid=\"56\">\n                        <div data-kid=\"57\">\n                            <h3 class=\"font-['Playfair_Display'] text-4xl font-black text-[#0B132B]\" data-kid=\"58\">Yard Occupancy</h3>\n                            <p class=\"text-[#8C92AC] text-sm font-black uppercase tracking-[0.3em] mt-3\" data-kid=\"59\">Live Dispatch Monitor</p>\n                        </div>\n                        <div class=\"text-right\" data-kid=\"60\">\n                            <span class=\"text-xs font-black text-slate-500 block uppercase mb-2 tracking-widest opacity-60\" data-kid=\"61\">Facility Capacity</span>\n                            <span class=\"font-['Playfair_Display'] text-3xl font-black text-[#FF7900]\" data-kid=\"62\">200 Units</span>\n                        </div>\n                    </div>\n\n                    \n                    <div class=\"flex items-center justify-center gap-12 py-16 relative z-10\" data-kid=\"63\">\n                        <div class=\"flex flex-col items-center gap-5\" data-kid=\"64\">\n                            <div class=\"flex gap-4\" data-kid=\"65\">\n                                <div class=\"w-24 h-36 flip-card rounded-xl flex items-center justify-center\" data-kid=\"66\">\n                                    <span class=\"text-7xl font-black text-white flip-number\" data-kid=\"67\">0</span>\n                                </div>\n                                <div class=\"w-24 h-36 flip-card rounded-xl flex items-center justify-center\" data-kid=\"68\">\n                                    <span class=\"text-7xl font-black text-white flip-number\" data-kid=\"69\">4</span>\n                                </div>\n                                <div class=\"w-24 h-36 flip-card rounded-xl flex items-center justify-center\" data-kid=\"70\">\n                                    <span class=\"text-7xl font-black text-white flip-number\" data-kid=\"71\">2</span>\n                                </div>\n                            </div>\n                            <p class=\"text-xs font-black text-[#FF7900] uppercase tracking-[0.5em] bg-[#FF7900]/10 px-6 py-2 rounded-full border border-[#FF7900]/20\" data-kid=\"72\">Available Bays</p>\n                        </div>\n                        \n                        <div class=\"h-32 w-px bg-slate-300\" data-kid=\"73\"></div>\n\n                        <div class=\"flex flex-col items-center gap-5 opacity-40\" data-kid=\"74\">\n                            <div class=\"flex gap-4\" data-kid=\"75\">\n                                <div class=\"w-20 h-32 flip-card rounded-xl flex items-center justify-center bg-slate-800\" data-kid=\"76\">\n                                    <span class=\"text-5xl font-black text-white/40\" data-kid=\"77\">1</span>\n                                </div>\n                                <div class=\"w-20 h-32 flip-card rounded-xl flex items-center justify-center bg-slate-800\" data-kid=\"78\">\n                                    <span class=\"text-5xl font-black text-white/40\" data-kid=\"79\">5</span>\n                                </div>\n                                <div class=\"w-20 h-32 flip-card rounded-xl flex items-center justify-center bg-slate-800\" data-kid=\"80\">\n                                    <span class=\"text-5xl font-black text-white/40\" data-kid=\"81\">8</span>\n                                </div>\n                            </div>\n                            <p class=\"text-[10px] font-black text-slate-500 uppercase tracking-[0.4em]\" data-kid=\"82\">Occupied</p>\n                        </div>\n                    </div>\n\n                    <div class=\"flex items-center gap-8 mt-4 pt-10 border-t border-slate-200/60\" data-kid=\"83\">\n                        <div class=\"flex -space-x-5\" data-kid=\"84\">\n                            <img src=\"https://i.pravatar.cc/100?u=d1\" class=\"w-12 h-12 rounded-full border-4 border-[#F4F0EC]\" alt=\"D1\" data-kid=\"85\">\n                            <img src=\"https://i.pravatar.cc/100?u=d2\" class=\"w-12 h-12 rounded-full border-4 border-[#F4F0EC]\" alt=\"D2\" data-kid=\"86\">\n                            <img src=\"https://i.pravatar.cc/100?u=d3\" class=\"w-12 h-12 rounded-full border-4 border-[#F4F0EC]\" alt=\"D3\" data-kid=\"87\">\n                            <div class=\"w-12 h-12 rounded-full bg-[#E5E1DD] border-4 border-[#F4F0EC] flex items-center justify-center text-xs font-black\" data-kid=\"88\">+12</div>\n                        </div>\n                        <p class=\"text-xs font-bold text-slate-500 italic opacity-70\" data-kid=\"89\">Recent processed departures (last 60m)</p>\n                    </div>\n\n                    <div class=\"absolute -bottom-20 -right-20 opacity-5 pointer-events-none rotate-12\" data-kid=\"90\">\n                        <i class=\"ti ti-truck-delivery text-[350px]\" data-kid=\"91\"></i>\n                    </div>\n                </div>\n\n                \n                <div class=\"col-span-5 flex flex-col gap-12\" data-kid=\"92\">\n                    \n                    <div class=\"stacked-paper p-12 rounded-3xl group cursor-pointer bg-linear-to-br from-[#F4F0EC] to-[#EAE6E2] hard-offset\" data-kid=\"93\">\n                        <div class=\"flex justify-between items-start mb-8\" data-kid=\"94\">\n                            <div class=\"w-16 h-16 rounded-2xl bg-[#0B132B] flex items-center justify-center text-[#FF7900] border-2 border-white/10 shadow-2xl\" data-kid=\"95\">\n                                <i class=\"ti ti-currency-dollar text-4xl\" data-kid=\"96\"></i>\n                            </div>\n                            <div class=\"text-right\" data-kid=\"97\">\n                                <span class=\"text-[12px] font-black text-white bg-emerald-600 px-4 py-2 rounded-md uppercase tracking-widest shadow-xl\" data-kid=\"98\">▲ $320 Today</span>\n                            </div>\n                        </div>\n                        <h4 class=\"text-xs font-black text-[#8C92AC] uppercase tracking-[0.3em] mb-3\" data-kid=\"99\">Daily Ledger Revenue</h4>\n                        <div class=\"flex items-baseline gap-4\" data-kid=\"100\">\n                            <span class=\"font-['Playfair_Display'] text-6xl font-black text-[#0B132B]\" data-kid=\"101\">$12,450</span>\n                            <span class=\"text-[#8C92AC] font-bold text-base tracking-tighter\" data-kid=\"102\">TOTAL USD</span>\n                        </div>\n                    </div>\n\n                    \n                    <div class=\"stacked-paper p-12 rounded-3xl group cursor-pointer border-2 border-slate-200\" data-kid=\"103\">\n                        <div class=\"flex justify-between items-start mb-8\" data-kid=\"104\">\n                            <div class=\"w-14 h-14 rounded-xl bg-blue-50 flex items-center justify-center text-blue-600 border border-blue-200\" data-kid=\"105\">\n                                <i class=\"ti ti-history text-3xl\" data-kid=\"106\"></i>\n                            </div>\n                            <div class=\"flex flex-col gap-1 items-end\" data-kid=\"107\">\n                                <span class=\"text-[11px] font-black text-blue-700 bg-blue-100/50 px-3 py-1.5 rounded-md border border-blue-200 uppercase tracking-tighter\" data-kid=\"108\">18 Daily Units</span>\n                                <span class=\"text-[11px] font-black text-indigo-700 bg-indigo-100/50 px-3 py-1.5 rounded-md border border-indigo-200 uppercase tracking-tighter\" data-kid=\"109\">82 Monthly Units</span>\n                            </div>\n                        </div>\n                        <h4 class=\"text-xs font-black text-[#8C92AC] uppercase tracking-[0.3em] mb-3\" data-kid=\"110\">Verified Site Inventory</h4>\n                        <div class=\"flex items-baseline gap-4\" data-kid=\"111\">\n                            <span class=\"font-['Playfair_Display'] text-6xl font-black text-[#0B132B]\" data-kid=\"112\">158</span>\n                            <span class=\"text-slate-500 font-bold text-base opacity-60\" data-kid=\"113\">Units In Yard</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            \n            <div class=\"grid grid-cols-12 gap-12 items-start\" data-kid=\"114\">\n                \n                \n                <div class=\"col-span-8 space-y-12\" data-kid=\"115\">\n                    <div class=\"flex items-center justify-between\" data-kid=\"116\">\n                        <div data-kid=\"117\">\n                            <h3 class=\"font-['Playfair_Display'] text-4xl font-black text-[#0B132B]\" data-kid=\"118\">Yard Dispatch Ledger</h3>\n                            <p class=\"text-[#8C92AC] text-xs font-black uppercase tracking-[0.3em] mt-2\" data-kid=\"119\">Current Active Inventory Monitor</p>\n                        </div>\n                        <div class=\"flex gap-5\" data-kid=\"120\">\n                            <button class=\"embossed-btn px-8 py-3 rounded-xl text-[#0B132B] font-black uppercase tracking-widest text-[10px] flex items-center gap-3\" data-kid=\"121\">\n                                <i class=\"ti ti-filter text-xl\" data-kid=\"122\"></i> Filter List\n                            </button>\n                            <button class=\"embossed-btn px-8 py-3 rounded-xl text-[#0B132B] font-black uppercase tracking-widest text-[10px] flex items-center gap-3\" data-kid=\"123\">\n                                <i class=\"ti ti-printer text-xl\" data-kid=\"124\"></i> Print Ledger\n                            </button>\n                        </div>\n                    </div>\n\n                    <div class=\"overflow-hidden\" data-kid=\"125\">\n                        <table class=\"w-full text-left border-separate border-spacing-y-4\" data-kid=\"126\">\n                            <thead data-kid=\"127\">\n                                <tr data-kid=\"128\">\n                                    <th class=\"px-10 py-3 text-sm font-black text-slate-500 uppercase tracking-widest\" data-kid=\"129\">Vehicle #</th>\n                                    <th class=\"px-10 py-3 text-sm font-black text-slate-500 uppercase tracking-widest\" data-kid=\"130\">Carrier / Fleet</th>\n                                    <th class=\"px-10 py-3 text-sm font-black text-slate-500 uppercase tracking-widest text-center\" data-kid=\"131\">Status</th>\n                                    <th class=\"px-10 py-3 text-sm font-black text-slate-500 uppercase tracking-widest\" data-kid=\"132\">Expiration</th>\n                                    <th class=\"px-10 py-3\" data-kid=\"133\"></th>\n                                </tr>\n                            </thead>\n                            <tbody data-kid=\"134\">\n                                <tr class=\"ledger-row bg-white/60 hover:bg-white shadow-sm cursor-pointer rounded-2xl transition-colors\" data-kid=\"135\">\n                                    <td class=\"px-10 py-8 font-black text-[#0B132B] text-lg border-l-4 border-emerald-600 rounded-l-2xl\" data-kid=\"136\">TX-90210</td>\n                                    <td class=\"px-10 py-8 text-base font-bold text-slate-600\" data-kid=\"137\">Swift Transportation Inc.</td>\n                                    <td class=\"px-10 py-8 text-center\" data-kid=\"138\">\n                                        <div class=\"stamp-seal stamp-active\" data-kid=\"139\">ACTIVE</div>\n                                    </td>\n                                    <td class=\"px-10 py-8 text-sm font-black text-slate-500 uppercase tracking-tighter\" data-kid=\"140\">Today, 18:30 PM</td>\n                                    <td class=\"px-10 py-8 text-right rounded-r-2xl pr-12\" data-kid=\"141\">\n                                        <i class=\"ti ti-chevron-right text-slate-300 text-xl\" data-kid=\"142\"></i>\n                                    </td>\n                                </tr>\n                                <tr class=\"ledger-row bg-white/60 hover:bg-white shadow-sm cursor-pointer rounded-2xl transition-colors\" data-kid=\"143\">\n                                    <td class=\"px-10 py-8 font-black text-[#0B132B] text-lg border-l-4 border-amber-500 rounded-l-2xl\" data-kid=\"144\">MI-48174</td>\n                                    <td class=\"px-10 py-8 text-base font-bold text-slate-600\" data-kid=\"145\">Penske Logistics Fleet</td>\n                                    <td class=\"px-10 py-8 text-center\" data-kid=\"146\">\n                                        <div class=\"stamp-seal stamp-warning\" data-kid=\"147\">EXPIRING</div>\n                                    </td>\n                                    <td class=\"px-10 py-8 text-sm font-black text-rose-600 uppercase tracking-tighter\" data-kid=\"148\">Deadline: 45 Min</td>\n                                    <td class=\"px-10 py-8 text-right rounded-r-2xl pr-12\" data-kid=\"149\">\n                                        <i class=\"ti ti-chevron-right text-slate-300 text-xl\" data-kid=\"150\"></i>\n                                    </td>\n                                </tr>\n                                <tr class=\"ledger-row bg-white/60 hover:bg-white shadow-sm cursor-pointer rounded-2xl transition-colors\" data-kid=\"151\">\n                                    <td class=\"px-10 py-8 font-black text-[#0B132B] text-lg border-l-4 border-emerald-600 rounded-l-2xl\" data-kid=\"152\">NJ-77382</td>\n                                    <td class=\"px-10 py-8 text-base font-bold text-slate-600\" data-kid=\"153\">FedEx Ground Contractors</td>\n                                    <td class=\"px-10 py-8 text-center\" data-kid=\"154\">\n                                        <div class=\"stamp-seal stamp-active\" data-kid=\"155\">ACTIVE</div>\n                                    </td>\n                                    <td class=\"px-10 py-8 text-sm font-bold text-slate-500 uppercase tracking-tighter\" data-kid=\"156\">Monthly (Jul 30)</td>\n                                    <td class=\"px-10 py-8 text-right rounded-r-2xl pr-12\" data-kid=\"157\">\n                                        <i class=\"ti ti-chevron-right text-slate-300 text-xl\" data-kid=\"158\"></i>\n                                    </td>\n                                </tr>\n                            </tbody>\n                        </table>\n                    </div>\n                </div>\n\n                \n                <div class=\"col-span-4 space-y-12\" data-kid=\"159\">\n                    <div class=\"flex items-center gap-4 mb-3\" data-kid=\"160\">\n                        <div class=\"w-10 h-10 rounded-full bg-[#FF7900]/10 flex items-center justify-center text-[#FF7900]\" data-kid=\"161\">\n                            <i class=\"ti ti-bulb text-2xl\" data-kid=\"162\"></i>\n                        </div>\n                        <h3 class=\"font-['Playfair_Display'] text-2xl font-black text-[#0B132B]\" data-kid=\"163\">Dispatcher Notes</h3>\n                    </div>\n\n                    <div class=\"relative min-h-[550px] w-full bg-linear-to-b from-slate-300/40 to-slate-200/40 rounded-3xl border-4 ridge-border p-12 flex flex-col items-center shadow-xl\" data-kid=\"164\">\n                        <div class=\"absolute top-0 left-1/2 -translate-x-1/2 w-48 h-12 bg-slate-800 rounded-b-3xl flex items-center justify-center border-x-4 border-b-4 border-slate-700 shadow-2xl z-50\" data-kid=\"165\">\n                            <div class=\"w-32 h-1.5 bg-slate-900 rounded-full\" data-kid=\"166\"></div>\n                        </div>\n\n                        \n                        <div class=\"flex flex-col gap-10 w-full pt-10\" data-kid=\"167\">\n                            <div class=\"polaroid rotate-[-3deg] w-full max-w-[320px] mx-auto z-20 cursor-pointer shadow-2xl border border-slate-200\" data-kid=\"168\">\n                                <div class=\"washi-tape\" data-kid=\"169\"></div>\n                                <div class=\"w-full h-36 bg-[#FF7900]/5 flex items-center justify-center border border-[#FF7900]/10\" data-kid=\"170\">\n                                    <i class=\"ti ti-award text-5xl text-[#FF7900]\" data-kid=\"171\"></i>\n                                </div>\n                                <div class=\"mt-5 space-y-2 px-2\" data-kid=\"172\">\n                                    <p class=\"font-['Playfair_Display'] text-base font-black italic text-[#0B132B]\" data-kid=\"173\">VIP Fleet Conversion</p>\n                                    <p class=\"text-xs text-slate-600 leading-relaxed font-medium\" data-kid=\"174\">Carrier #NJ-77382 issued 12 daily passes. Suggest monthly account migration for $230/mo discount.</p>\n                                </div>\n                            </div>\n\n                            <div class=\"polaroid rotate-[4deg] w-full max-w-[320px] mx-auto z-10 cursor-pointer shadow-2xl border border-slate-200\" data-kid=\"175\">\n                                <div class=\"washi-tape !bg-emerald-600 opacity-50\" data-kid=\"176\"></div>\n                                <div class=\"w-full h-36 bg-emerald-50 border border-emerald-100 relative overflow-hidden\" data-kid=\"177\">\n                                    <img src=\"https://images.pexels.com/photos/6045262/pexels-photo-6045262.jpeg?auto=compress&cs=tinysrgb&w=400&q=80\" class=\"w-full h-full object-cover grayscale opacity-70\" alt=\"Fleet\" data-kid=\"178\">\n                                </div>\n                                <div class=\"mt-5 space-y-2 px-2\" data-kid=\"179\">\n                                    <p class=\"font-['Playfair_Display'] text-base font-black italic text-[#0B132B]\" data-kid=\"180\">Volume Discount Opportunity</p>\n                                    <p class=\"text-xs text-slate-600 leading-relaxed font-medium\" data-kid=\"181\">Swift Logistics fleet reached 25+ daily units today. Dispatch carrier bulk rate proposal for Q3 renewal.</p>\n                                </div>\n                            </div>\n                        </div>\n\n                        \n                        <div class=\"absolute bottom-6 right-6 p-6 bg-yellow-100/90 shadow-[8px_8px_0_rgba(0,0,0,0.15)] border border-yellow-200 rounded-sm rotate-[3deg] z-40 max-w-[220px]\" data-kid=\"182\">\n                            <p class=\"text-[11px] font-black uppercase text-yellow-800 tracking-[0.1em] mb-3 border-b border-yellow-300/50 pb-2\" data-kid=\"183\">Shift Memo</p>\n                            <p class=\"text-xs text-yellow-900 leading-snug italic font-medium\" data-kid=\"184\">Shift A: 3 monthly renewals pending for Jul 30. SMS automated notifications verified and delivered.</p>\n                        </div>\n                    </div>\n\n                    <div class=\"neomorph-raised p-8 rounded-3xl border border-black/5 hard-offset !border-rose-900/10\" data-kid=\"185\">\n                        <div class=\"flex items-center gap-4 mb-6\" data-kid=\"186\">\n                            <div class=\"w-10 h-10 rounded-full bg-rose-100 flex items-center justify-center text-rose-600 border border-rose-200\" data-kid=\"187\">\n                                <i class=\"ti ti-alert-triangle text-xl\" data-kid=\"188\"></i>\n                            </div>\n                            <p class=\"text-xs font-black uppercase tracking-[0.3em] text-slate-500\" data-kid=\"189\">Critical Alert</p>\n                        </div>\n                        <p class=\"text-base font-bold text-slate-800 leading-relaxed mb-6\" data-kid=\"190\">Penske Fleet #MI-48174 is 2 days past yard deadline. Immediate unit inspection required at East Gate.</p>\n                        <button class=\"w-full py-3 bg-rose-700 text-white text-xs font-black uppercase tracking-widest rounded-xl hover:bg-rose-800 active:scale-95 transition-all shadow-xl\" data-kid=\"191\">Resolve Conflict</button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </main>\n\n    \n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"192\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"193\"></script>\n    <script data-kid=\"194\">gsap.registerPlugin(ScrollTrigger);</script>\n    <script type=\"module\" data-kid=\"195\">\n        import { animate, scroll, inView, hover } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n        import Lenis from \"https://esm.sh/lenis@1\"\n\n        // Initialize Lenis for smooth scrolling\n        const lenis = new Lenis({ autoRaf: true });\n\n        // Hero count-up for flip clock\n        inView(\".flip-number\", (info) => {\n            const el = info.target;\n            const finalValue = parseInt(el.textContent);\n            animate(0, finalValue, {\n                duration: 2.5,\n                ease: \"circOut\",\n                onUpdate: (val) => el.textContent = Math.round(val)\n            });\n        });\n\n        // Physical Hover Effects for cards (Removing CSS transition conflicts)\n        document.querySelectorAll(\".stacked-paper\").forEach(el => {\n            hover(el, () => {\n                animate(el, { y: -15, scale: 1.01 }, { type: \"spring\", stiffness: 350, damping: 20 });\n                return () => animate(el, { y: 0, scale: 1 }, { type: \"spring\", stiffness: 250, damping: 25 });\n            });\n        });\n\n        // GSAP reveals for ledger rows (using simple class)\n        gsap.from(\".ledger-row\", {\n            scrollTrigger: {\n                trigger: \"table\",\n                start: \"top 85%\",\n                toggleActions: \"play none none none\"\n            },\n            opacity: 0,\n            x: -40,\n            duration: 0.8,\n            stagger: 0.15,\n            ease: \"power4.out\"\n        });\n\n        // Polaroid Entry and Hover Effects (Manual GSAP to avoid transition conflicts)\n        gsap.from(\".polaroid\", {\n            scale: 0.4,\n            opacity: 0,\n            y: 60,\n            duration: 1.2,\n            stagger: 0.3,\n            ease: \"elastic.out(1, 0.75)\",\n            delay: 0.6,\n            clearProps: \"opacity,scale\"\n        });\n\n        document.querySelectorAll(\".polaroid\").forEach(el => {\n            el.addEventListener(\"mouseenter\", () => {\n                gsap.to(el, { scale: 1.05, rotation: 0, zIndex: 100, duration: 0.4, ease: \"power2.out\" });\n            });\n            el.addEventListener(\"mouseleave\", () => {\n                const initialRotation = el.classList.contains(\"rotate-[-3deg]\") ? -3 : 4;\n                gsap.to(el, { scale: 1, rotation: initialRotation, zIndex: 20, duration: 0.4, ease: \"power2.inOut\" });\n            });\n        });\n\n        // Embossed button spring press effects\n        document.querySelectorAll(\".embossed-btn, .nav-plaque\").forEach(btn => {\n            btn.addEventListener(\"mousedown\", () => {\n                gsap.to(btn, { scale: 0.94, duration: 0.1 });\n            });\n            btn.addEventListener(\"mouseup\", () => {\n                gsap.to(btn, { scale: 1, duration: 0.4, ease: \"elastic.out(1, 0.3)\" });\n            });\n        });\n    </script>\n</section>\n",
