# === Secrets & local config (NEVER commit) ===
**/.env
**/.env.local
**/.env.*.local
backend/.jwt_secret

# === Databases & data ===
*.db
*.sqlite
*.sqlite3

# === Logs ===
logs/
*.log
backend/uvicorn.out.log
backend/uvicorn.err.log
frontend/nextdev.out.log
frontend/nextdev.err.log

# === Python ===
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/

# === Node / Next.js ===
node_modules/
.next/
out/
next-env.d.ts

# === OS / editor ===
.DS_Store
Thumbs.db
.vscode/
.idea/

# production secrets + backups + db snapshots
.env.prod
backups/
*.db.bak

# === gstack (local tooling artifacts) ===
# QA and security reports are local-only — they should never be committed.
.gstack/

# === graphify ===
# The graph itself is committed; the cache and resolved absolute paths are machine-local.
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_root
# Dated snapshots a rebuild takes before overwriting the graph, and its checksums.
graphify-out/20*/
graphify-out/*.sig
graphify-out/memory/
graphify-out/reflections/
