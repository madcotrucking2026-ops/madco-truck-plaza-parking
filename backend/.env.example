# Copy to `.env` and fill in for production. Anything omitted uses the
# in-code default (fine for local dev, NOT all fine for production — see notes).

# --- Database ---
# Local dev defaults to a SQLite file. Point at Postgres in production.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/mtpms

# --- Auth ---
# If unset, a random secret is generated once and saved to backend/.jwt_secret.
# For production (especially multiple app instances / containers), set an
# explicit shared value so tokens stay valid across restarts and instances.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# JWT_SECRET=

# --- Public URLs ---
# The domain the CUSTOMER-FACING app is served from. Used to build the QR-code
# verify link printed on each pass (a guard scans it with a phone), so it MUST
# be a URL a phone can actually reach — not localhost — in production.
# PUBLIC_BASE_URL=https://park.madcotruckplaza.com

# Origins allowed to call this API from a browser (JSON array). Set to the
# deployed frontend origin(s).
# CORS_ORIGINS=["https://park.madcotruckplaza.com"]

# --- Stripe (card payments) ---
# Test keys to start; swap for sk_live_/pk_live_ once business verification is
# done and you're ready to take real money.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook signing secret from Stripe Dashboard → Developers → Webhooks. Enables
# the reconciliation safety net (charge succeeded but browser died before the
# pass was recorded). Optional but recommended for production.
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Twilio SMS (monthly renewal reminders) ---
# Until these are set, reminders are still recorded (and shown in the app), but
# no actual text message is sent. Add real credentials to enable SMS sending.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+13135550100
# A2P 10DLC: send through the registered Messaging Service (recommended) —
# takes precedence over the from-number when set.
# TWILIO_MESSAGING_SERVICE_SID=MG...
# Automatic daily renewal-reminder sweep (7/3/1 days before + daily overdue).
# On by default; set to false to turn off automatic texting.
# AUTO_REMINDERS_ENABLED=true

# --- Pricing overrides (optional; defaults 20/100/250) ---
# DAILY_PRICE=20
# WEEKLY_PRICE=100
# MONTHLY_PRICE=250
